# From your app at https://developer.linkedin.com → My apps → Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URL" registered in the app's Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Optional: LinkedIn API version header (YYYYMM, must be within the last 12 months).
# Defaults to two months before today; set only if that month has no release.
# LINKEDIN_VERSION=202605

# Enables the "Generate draft" button — free key from https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# Protects the scheduled /api/cron endpoint. Vercel Cron sends this as a Bearer token.
# Generate one with: openssl rand -hex 32   (when unset, /api/cron is open in dev only)
CRON_SECRET=

# Durable storage (account/schedule/queue/history) via Upstash Redis. Auto-set by the
# Vercel Marketplace "Upstash for Redis" integration. When BOTH are unset, the app
# falls back to local JSON files under data/ — fine for local dev, ephemeral on Vercel.
# Pull the provisioned values locally with: vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
